# Copy this file to .env and fill in real values before running with --live.
# Never commit your real .env file.

# --- Robinhood credentials (unofficial robin_stocks client) ---
# NOT used by the default --live path. USE_ROBINHOOD_MCP=true (below,
# default) talks only to Robinhood's official OAuth-based MCP server --
# account data, underlying price bars, options chain/quotes/order placement
# are all covered there now, with no robin_stocks login or automation at
# all. Only fill these in if you set USE_ROBINHOOD_MCP=false.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Base32 TOTP secret from Robinhood's "authenticator app" 2FA setup (not SMS codes).
ROBINHOOD_TOTP_SECRET=

# --- Robinhood Agentic Trading MCP (official, OAuth-based; optional) ---
# When true (default), --live uses Robinhood's official MCP server for
# everything: account/equity data, underlying price bars, and 0DTE options
# (chain lookup, quotes, order placement) via OAuth login in your browser,
# no password sharing and no robin_stocks involved. Set to false to use
# robin_stocks for everything instead, like before this existed -- a
# reasonable fallback if the MCP path ever misbehaves, but note this
# reintroduces the ToS risk of automating an unofficial client.
USE_ROBINHOOD_MCP=true
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN_CACHE_PATH=.robinhood_mcp_tokens.json
ROBINHOOD_MCP_OAUTH_PORT=8765

# --- Tickers tracked ---
# Comma-separated list of symbols the agent watches. One position per
# symbol may be open at a time, up to len(SYMBOLS) concurrently -- see
# README.md. MAX_TRADES_PER_DAY/MAX_DAILY_LOSS_PCT (below) apply globally
# across all of them combined, not per symbol.
SYMBOLS=SPY,IWM,NVDA,MSTR,HOOD,COIN,PLTR,UBER

# --- Strategy selection ---
# "orb" (opening-range breakout, default) or "gameplan" (manual hold/
# rejection zones -- ported from a TradingView indicator, see README.md).
# NOTE: gameplan strategy only trades the first symbol in SYMBOLS -- its
# manually-input zones don't generalize to multiple tickers at once.
STRATEGY=orb

# --- ORB strategy parameters ---
# 5-minute opening range, built from 1-minute bars (both for the range
# itself and for breakout entries) -- matches the ORB+EMA-cloud "A+ setup"
# this strategy is tuned around. See README.md.
ORB_MINUTES=5
VWAP_FILTER=true

# How far from the current price (in dollars, not strikes) to select an
# entry contract: a CALL targets underlying_price + STRIKE_DOLLAR_OFFSET, a
# PUT targets underlying_price - STRIKE_DOLLAR_OFFSET, then whichever
# strike the chain actually has closest to that target is used (handles
# chains without exact $1 increments). See README.md.
STRIKE_DOLLAR_OFFSET=1.0

# --- Additional confirming filters (each trades signal frequency for quality) ---
# Requires EMA8/EMA9 ("Cloud 1") and EMA34/EMA50 ("Cloud 3") to both agree
# with the breakout direction -- the Ripster EMA Cloud confluence that
# defines an "A+ setup". Default ON: this is the primary quality filter
# this strategy is built around, not an experimental extra. See README.md.
EMA_CLOUD_FILTER=true
# Volume/breakout-buffer default OFF: a real backtest comparison didn't
# show a clear benefit, so the agent behaves the same as it did before
# these existed unless you explicitly turn one on to experiment. See
# README.md for the full reasoning behind how each is computed.
#
# Requires the breakout bar's volume to beat VOLUME_MULTIPLIER x the average
# volume of the last VOLUME_LOOKBACK_BARS bars, counting only bars after the
# opening range closed. Filters out breakouts on thin participation.
VOLUME_FILTER=false
VOLUME_MULTIPLIER=1.5
VOLUME_LOOKBACK_BARS=6
# Requires the close to clear the ORB high/low by this fraction (0.001 =
# 0.1%), not just tick through it by any amount -- cuts down on breakouts
# that immediately fail back into the range. 0 = disabled.
BREAKOUT_BUFFER_PCT=0.0
# Full Timeframe Continuity: requires the current daily candle ("daily") --
# and, in "full", the current 60m/30m candles too -- to also be pointing
# the breakout's direction. "off" (default) imposes no restriction. Off by
# default -- not yet backtest-validated, unlike EMA_CLOUD_FILTER. See
# README.md.
FTFC_MODE=off

# --- Dynamic profit target (ORB entries only) ---
# When true, ORB entries ALSO get an underlying-price-based target
# (DYNAMIC_PT_MULTIPLIER x the breakout candle's own high-low range,
# projected from entry) -- checked IN ADDITION to the usual
# PROFIT_TARGET_PCT premium-based target above, not instead of it. Off by
# default, same reasoning as VOLUME_FILTER/BREAKOUT_BUFFER_PCT: implemented
# and available to compare via backtest, not assumed to help until
# validated. See README.md.
DYNAMIC_PROFIT_TARGET=false
DYNAMIC_PT_MULTIPLIER=2.0

# --- Retest entries (a second, independent entry mechanism) ---
# Waits for a confirmed ORB breakout, then a LATER candle that wicks back
# to retest the broken level and closes back outside it, with a confirming
# candlestick pattern (Hammer/Bullish Engulfing or Shooting Star/Bearish
# Engulfing). Entry/stop/target are all underlying-price-based (its own
# R:R system, independent of STOP_LOSS_PCT/PROFIT_TARGET_PCT, which still
# apply too as a premium-decay backstop). Only evaluated when the primary
# ORB+EMA-cloud signal doesn't fire that cycle. Off by default -- this is a
# whole new kind of trade the agent can place, not just a filter. See
# README.md.
ENABLE_RETEST_ENTRIES=false
RETEST_CONTINUATION=true
RETEST_REVERSAL=true
RETEST_RR_RATIO=2.0
# Pushes the underlying-price stop beyond the retest candle's raw wick by
# this many ATR(14)s, so ordinary noise doesn't tag it immediately. 0
# (default) = stop sits exactly on the wick.
RETEST_SL_ATR_MULT=0.0
# A true Hammer/Shooting Star requires a prior local downtrend/uptrend
# (else it's a Hanging Man/Inverted Hammer -- a weak, contested shape).
RETEST_REQUIRE_TREND_CONTEXT=true
RETEST_TREND_LOOKBACK=5
# Both off by default, matching the indicator's own defaults -- retest
# entries are evaluated independently of EMA_CLOUD_FILTER/FTFC_MODE above
# unless explicitly opted into here too.
RETEST_CLOUD_FILTER=false
RETEST_FTFC_FILTER=false

# --- Gameplan strategy parameters (only used when STRATEGY=gameplan) ---
GAMEPLAN_REQUIRE_BULL_CLOSE=true
GAMEPLAN_REQUIRE_BEAR_CLOSE=true
# How long the agent waits for you to send today's zones via Telegram (or
# the terminal prompt) before giving up and not trading for the day.
GAMEPLAN_ZONE_REQUEST_TIMEOUT_SECONDS=1800

# --- Risk management ---
# RISK_PCT_PER_TRADE only drives backtest.py's unattended position sizing.
# Live/paper entries never compute a single quantity from this -- instead
# you're offered a choice of 1/3/5 contracts (whichever you can afford,
# capped by MAX_CONTRACTS_PER_TRADE) at approval time. See README.md.
RISK_PCT_PER_TRADE=0.01
STOP_LOSS_PCT=0.50
PROFIT_TARGET_PCT=1.00
MAX_TRADES_PER_DAY=2
MAX_DAILY_LOSS_PCT=0.03
MAX_CONTRACTS_PER_TRADE=5

# --- Session timing (24h, local time) ---
MARKET_OPEN=09:30
ENTRY_CUTOFF=14:30
HARD_EXIT=15:45
MARKET_CLOSE=16:00

POLL_SECONDS=60
# How often /status and the Positions button are checked, separate from
# POLL_SECONDS above -- a status check is a cheap Telegram-only call, not a
# broker call, so it can run far more often without adding real API load.
# Keeps status replies snappy (a few seconds) instead of waiting up to a
# full POLL_SECONDS cycle.
STATUS_POLL_SECONDS=5
TRADE_LOG_PATH=trade_log.csv

# --- Telegram alerts + approve/decline (optional) ---
# Leave both blank to fall back to the terminal y/N prompt with no remote
# alerts. See README.md for how to create a bot and find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CONFIRM_TIMEOUT_SECONDS=300
