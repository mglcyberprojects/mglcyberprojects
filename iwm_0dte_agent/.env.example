# Copy this file to .env and fill in real values before running with --live.
# Never commit your real .env file.

# --- Robinhood credentials (only needed for --live) ---
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Base32 TOTP secret from Robinhood's "authenticator app" 2FA setup (not SMS codes).
ROBINHOOD_TOTP_SECRET=

# --- Strategy parameters ---
ORB_MINUTES=15
VWAP_FILTER=true
STRIKE_OFFSET=0

# --- Risk management ---
RISK_PCT_PER_TRADE=0.01
STOP_LOSS_PCT=0.50
PROFIT_TARGET_PCT=1.00
MAX_TRADES_PER_DAY=2
MAX_DAILY_LOSS_PCT=0.03
MAX_CONTRACTS_PER_TRADE=5

# --- Session timing (24h, local time) ---
MARKET_OPEN=09:30
ENTRY_CUTOFF=14:30
HARD_EXIT=15:45
MARKET_CLOSE=16:00

POLL_SECONDS=60
TRADE_LOG_PATH=trade_log.csv

# --- Telegram alerts + approve/decline (optional) ---
# Leave both blank to fall back to the terminal y/N prompt with no remote
# alerts. See README.md for how to create a bot and find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CONFIRM_TIMEOUT_SECONDS=300
