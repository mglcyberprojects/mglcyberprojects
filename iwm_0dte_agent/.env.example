# Copy this file to .env and fill in real values before running with --live.
# Never commit your real .env file.

# --- Robinhood credentials (unofficial robin_stocks client) ---
# NOT used by the default --live path. USE_ROBINHOOD_MCP=true (below,
# default) talks only to Robinhood's official OAuth-based MCP server --
# account data, underlying price bars, options chain/quotes/order placement
# are all covered there now, with no robin_stocks login or automation at
# all. Only fill these in if you set USE_ROBINHOOD_MCP=false.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Base32 TOTP secret from Robinhood's "authenticator app" 2FA setup (not SMS codes).
ROBINHOOD_TOTP_SECRET=

# --- Robinhood Agentic Trading MCP (official, OAuth-based; optional) ---
# When true (default), --live uses Robinhood's official MCP server for
# everything: account/equity data, underlying price bars, and 0DTE options
# (chain lookup, quotes, order placement) via OAuth login in your browser,
# no password sharing and no robin_stocks involved. Set to false to use
# robin_stocks for everything instead, like before this existed -- a
# reasonable fallback if the MCP path ever misbehaves, but note this
# reintroduces the ToS risk of automating an unofficial client.
USE_ROBINHOOD_MCP=true
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN_CACHE_PATH=.robinhood_mcp_tokens.json
ROBINHOOD_MCP_OAUTH_PORT=8765

# --- Strategy selection ---
# "orb" (opening-range breakout, default) or "gameplan" (manual hold/
# rejection zones -- ported from a TradingView indicator, see README.md).
STRATEGY=orb

# --- ORB strategy parameters ---
ORB_MINUTES=15
VWAP_FILTER=true
STRIKE_OFFSET=0

# --- Additional confirming filters (each trades signal frequency for quality) ---
# Default OFF: a real backtest comparison didn't show a clear benefit, so
# the agent behaves the same as it did before these existed unless you
# explicitly turn one on to experiment. See README.md for the full
# reasoning behind how each is computed.
#
# Requires the breakout bar's volume to beat VOLUME_MULTIPLIER x the average
# volume of the last VOLUME_LOOKBACK_BARS bars, counting only bars after the
# opening range closed. Filters out breakouts on thin participation.
VOLUME_FILTER=false
VOLUME_MULTIPLIER=1.5
VOLUME_LOOKBACK_BARS=6
# Requires the close to clear the ORB high/low by this fraction (0.001 =
# 0.1%), not just tick through it by any amount -- cuts down on breakouts
# that immediately fail back into the range. 0 = disabled.
BREAKOUT_BUFFER_PCT=0.0

# --- Small-account smoke-test mode (e.g. testing with $50) ---
# When true, ignores STRIKE_OFFSET and picks the cheapest strike at least
# OTM_MIN_DISCOUNT_PCT below the ATM contract's ask (walking further
# out-of-the-money strike by strike until it finds one cheap enough) -- this
# strike selection applies in live/paper mode too, not just backtest.py.
# The "buys exactly 1 contract" sizing half only applies in backtest.py's
# unattended runs (replacing RiskManager.position_size() there); live/paper
# sessions always let you pick 1/3/5 contracts at approval time regardless
# of this flag. See README.md.
CHEAP_OTM_MODE=false
OTM_MIN_DISCOUNT_PCT=0.70

# --- Gameplan strategy parameters (only used when STRATEGY=gameplan) ---
GAMEPLAN_REQUIRE_BULL_CLOSE=true
GAMEPLAN_REQUIRE_BEAR_CLOSE=true
# How long the agent waits for you to send today's zones via Telegram (or
# the terminal prompt) before giving up and not trading for the day.
GAMEPLAN_ZONE_REQUEST_TIMEOUT_SECONDS=1800

# --- Risk management ---
# RISK_PCT_PER_TRADE only drives backtest.py's unattended position sizing.
# Live/paper entries never compute a single quantity from this -- instead
# you're offered a choice of 1/3/5 contracts (whichever you can afford,
# capped by MAX_CONTRACTS_PER_TRADE) at approval time. See README.md.
RISK_PCT_PER_TRADE=0.01
STOP_LOSS_PCT=0.50
PROFIT_TARGET_PCT=1.00
MAX_TRADES_PER_DAY=2
MAX_DAILY_LOSS_PCT=0.03
MAX_CONTRACTS_PER_TRADE=5

# --- Session timing (24h, local time) ---
MARKET_OPEN=09:30
ENTRY_CUTOFF=14:30
HARD_EXIT=15:45
MARKET_CLOSE=16:00

POLL_SECONDS=60
TRADE_LOG_PATH=trade_log.csv

# --- Telegram alerts + approve/decline (optional) ---
# Leave both blank to fall back to the terminal y/N prompt with no remote
# alerts. See README.md for how to create a bot and find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CONFIRM_TIMEOUT_SECONDS=300
